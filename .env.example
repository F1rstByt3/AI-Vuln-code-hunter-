# =============================================================================
# AI Vuln Code Hunter — environment configuration
# Copy to .env and fill in. Anything left blank falls back to safe dev defaults.
# =============================================================================

# ---- Core ----
ENVIRONMENT=dev                       # dev | prod
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000

# ---- Database (Postgres) ----
# Dev default points at the docker-compose 'db' service.
DATABASE_URL=postgresql+asyncpg://hunter:hunter@db:5432/hunter

# ---- Queue / events (Redis) ----
REDIS_URL=redis://redis:6379/0

# ---- Object storage ----
# STORAGE_BACKEND=s3 uses the MinIO/S3 settings below (dev default).
# STORAGE_BACKEND=azure_blob uses the Azure settings (prod).
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=hunter
S3_SECRET_KEY=hunter-secret
S3_BUCKET=hunter-artifacts
S3_REGION=us-east-1
# Azure Blob (prod) — uses managed identity if key/conn-string omitted.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=hunter-artifacts
AZURE_STORAGE_CONNECTION_STRING=

# ---- AI Reviewer (Azure AI Foundry or local models) ----
# Leave FOUNDRY_ENDPOINT blank to run the agent in MOCK mode (no AI needed).
#
# AZURE:  https://my-resource.openai.azure.com  (appends /openai/v1/ automatically)
# LOCAL:  http://localhost:11434   (Ollama — auto-detected, appends /v1/)
#         http://localhost:8080    (vLLM / llama.cpp / LM Studio)
#         http://host.docker.internal:11434  (Ollama from inside Docker)
#
# Local models are auto-detected from localhost/127.0.0.1/host.docker.internal.
# Set FOUNDRY_API_STYLE=local to force local mode for other addresses.
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=gpt-codex            # Azure deployment or local model name
                                        # Ollama: llama3.1:70b, qwen2.5-coder:32b
                                        # vLLM: whatever you loaded
FOUNDRY_API_VERSION=preview            # 'preview' for latest features; ignored for local
FOUNDRY_API_STYLE=v1                    # v1 (Foundry) | azure (legacy) | local (force local)
# ---- Multi-model roles (optional; default to FOUNDRY_DEPLOYMENT) ----
# Different deployments per stage. Reviewers may be a comma-separated ensemble.
# Codex / o-series are auto-routed to the Responses API; others use Chat Completions.
# All of these are also editable in-app under Settings → Model roles.
#
# Recommended MAX-ACCURACY profile (UK South — use Data Zone Standard deployments
# to keep client code in the EU/UK boundary). Confirm names via Settings → List
# models. Use the strongest codex/GPT tier your resource exposes.
FOUNDRY_CHAT_MODEL=gpt-4o                       # live narration only — keep it fast/cheap
FOUNDRY_REVIEWER_MODELS=gpt-5.3-codex,gpt-5.4   # ensemble: deepest code+sec reasoning
FOUNDRY_JUDGE_MODEL=gpt-5.4                      # adjudicate/dedupe/validate evidence
FOUNDRY_EXPLOIT_MODEL=gpt-5.3-codex             # PoC + where-to-look + risk + fix
# Budget alternative: reviewers=gpt-4.1 (1M ctx → raise AI_BATCH_TOKENS, fewer
# batches), judge=o4-mini, exploit=gpt-5.3-codex (runs only on confirmed findings).
FOUNDRY_API_KEY=                        # or use the SP / managed-identity vars below
# Service principal (preferred over API key). If all three are set, used instead of key.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Use Foundry Agent Service (true) vs. raw chat-completions inference (false)
FOUNDRY_USE_AGENT_SERVICE=false

# ---- Auth (Microsoft Entra ID / OIDC) ----
# AUTH_DISABLED=true injects a dev admin user — DO NOT use in prod.
AUTH_DISABLED=true
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=                         # API app-registration audience / app-id-uri

# ---- Scanners ----
SEMGREP_ENABLED=true
SEMGREP_RULESET=auto                    # 'auto' | path to rules | registry ref
# SonarQube (optional, heavy). Start the server with: docker compose --profile sonar up
# then create a token at http://localhost:9090 (admin/admin) and set it below.
# These are .env DEFAULTS — all three are also editable in-app under
# Settings → Static scanners (DB values win over these).
SONARQUBE_ENABLED=false                 # true => run SonarScanner as part of the static sweep
SONARQUBE_URL=http://sonarqube:9000     # in-compose hostname; or any SonarQube instance
SONARQUBE_TOKEN=                         # squ_... token from the SonarQube UI

# ---- Ingestion limits / safety guards ----
MAX_UPLOAD_BYTES=10995116277760         # 10 TiB ceiling; per-archive guards below
MAX_EXTRACT_BYTES=53687091200           # 50 GiB extracted cap (zip-bomb guard)
MAX_EXTRACT_FILES=2000000               # max files per archive
MAX_FILE_BYTES_FOR_AI=1048576           # don't send files >1MiB to the LLM whole
UPLOAD_CHUNK_BYTES=8388608              # 8 MiB multipart chunk size

# ---- AI cost / behaviour controls ----
AI_MAX_FINDINGS_PER_SCAN=500
AI_BATCH_TOKENS=80000                    # tokens per reviewer batch; raise for 200K+ models
AI_TRIAGE_MODEL=                        # optional cheaper deployment for triage
AI_REQUIRE_EVIDENCE=true                # reject findings without file:line evidence
